---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Nav from './Nav.astro';
import Contact from './Contact.astro';
import { t, type Lang, url } from '../i18n';

interface Props { lang: Lang; entry: CollectionEntry<'cases'> }
const { lang, entry } = Astro.props;
const d = t[lang].cases;
const base = import.meta.env.BASE_URL;
const { Content } = await render(entry);
const all = (await getCollection('cases', (e) => e.id.startsWith(`${lang}/`) && !e.data.draft)).sort((a, b) => a.data.order - b.data.order);
const next = all[(all.findIndex((e) => e.id === entry.id) + 1) % all.length];
const caseUrl = (e: CollectionEntry<'cases'>) => url(base, `${lang === 'en' ? 'en/' : ''}cases/${e.id.split('/')[1]}/`);
const c = entry.data;
---
<Base lang={lang} title={c.title} description={c.summary}>
  <Nav lang={lang} />
  <main>
    <header class="top gut">
      <div class="wrap">
        <a class="back" href={url(base, lang === 'en' ? 'en/#cases' : '#cases')}><span class="arr">←</span> {d.all}</a>
        <h1 data-reveal><span class="line"><span>{c.title}</span></span></h1>
        <div class="intro">
          <p class="sum">{c.summary}</p>
          <dl class="meta">
            <div><dt>{d.kind}</dt><dd>{c.kind}</dd></div>
            <div><dt>{d.role}</dt><dd>{c.role}</dd></div>
            <div><dt>{d.year}</dt><dd>{c.year}</dd></div>
          </dl>
        </div>
      </div>
    </header>

    <div class="cover gut">
      {c.cover
        /* the full cover, uncropped: it carries its own composition */
        ? <div class="wrap shot"><img src={url(base, c.cover)} alt={c.title} /></div>
        : <div class:list={['wrap', 'media', c.tone]}><div class="px" data-parallax><div class="type"><span class="flair">{c.title}</span><span class="soon">{c.kind}, {d.soon}</span></div></div></div>}
    </div>

    <article class="body gut"><div class="wrap prose"><Content /></div></article>

    {c.link && <div class="gut src"><div class="wrap"><a class="btn ghost" href={c.link} target="_blank" rel="noopener">{d.source} <span class="arr">↗</span></a></div></div>}

    <a class="next gut" href={caseUrl(next)} data-cbub>
      <div class="wrap"><span class="tag">{d.next}</span><span class="nt">{next.data.title}</span></div>
    </a>
  </main>
  <Contact lang={lang} />
</Base>

<style>
  .top { padding-block: clamp(48px, 8vw, 120px) clamp(40px, 5vw, 64px); }
  .back { font-size: 14px; font-weight: 500; text-decoration: none; color: var(--mute); transition: color 0.3s var(--ease); }
  .back .arr { display: inline-block; transition: transform 0.35s var(--ease); }
  @media (hover: hover) { .back:hover { color: var(--ink); } .back:hover .arr { transform: translateX(-4px); } }
  h1 { margin: 24px 0 clamp(32px, 4vw, 56px); font-weight: 500; font-size: clamp(56px, 11vw, 176px); line-height: 0.92; letter-spacing: -0.065em; }
  .intro { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: clamp(24px, 4vw, 64px); align-items: end; }
  .sum { margin: 0; font-weight: 500; font-size: clamp(22px, 2.2vw, 32px); line-height: 1.2; letter-spacing: -0.03em; max-width: 26ch; }
  .meta { margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .meta dt { font-size: 13px; color: var(--mute); font-weight: 500; font-variation-settings: 'FLAR' 100; }
  .meta dd { margin: 6px 0 0; font-size: 15px; font-weight: 500; }

  .media { position: relative; aspect-ratio: 16 / 8; overflow: hidden; border-radius: var(--r); background: var(--paper); }
  .media.ink { background: var(--ink); color: var(--bg); } .media.mint { background: var(--mint); }
  .px { position: absolute; inset: -6% 0; }
  .shot img { width: 100%; height: auto; border-radius: var(--r); }
  .type { height: 100%; display: grid; align-content: space-between; padding: 8% 5%; }
  .type .flair { font-weight: 500; font-size: clamp(56px, 10vw, 160px); line-height: 0.9; letter-spacing: -0.06em; }
  .soon { font-size: 13px; font-weight: 500; opacity: 0.6; }

  .body { padding-block: clamp(72px, 10vw, 140px); }
  .prose { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2.2fr); column-gap: clamp(24px, 4vw, 64px); }
  .prose :global(h2) { grid-column: 1; margin: 0; padding-top: 4px; font-size: 15px; font-weight: 500; color: var(--mute); font-variation-settings: 'FLAR' 100; }
  .prose :global(:not(h2)) { grid-column: 2; }
  .prose :global(p), .prose :global(li) { font-size: clamp(18px, 1.5vw, 21px); line-height: 1.5; letter-spacing: -0.01em; max-width: 58ch; }
  .prose :global(p) { margin: 0 0 18px; }
  .prose :global(ul) { margin: 0 0 18px; padding-left: 22px; }
  .prose :global(li) { margin-bottom: 6px; }
  .prose :global(h2:not(:first-child)), .prose :global(h2:not(:first-child) + *) { margin-top: clamp(48px, 6vw, 80px); }
  .prose :global(strong) { font-weight: 500; background: linear-gradient(var(--mint), var(--mint)) no-repeat 0 90% / 100% .38em; }
  .src { padding-bottom: clamp(56px, 8vw, 110px); }

  .next { display: block; text-decoration: none; border-top: 1px solid var(--line); padding-block: clamp(56px, 8vw, 120px); }
  .next .wrap { display: grid; gap: 14px; }
  .nt { font-weight: 500; font-size: clamp(48px, 9vw, 140px); line-height: 0.95; letter-spacing: -0.065em; transition: transform 0.6s var(--ease); }
  @media (hover: hover) { .next:hover .nt { transform: translateX(16px); } }

  @media (max-width: 860px) {
    .intro { grid-template-columns: 1fr; }
    .meta { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .prose { grid-template-columns: 1fr; }
    .prose :global(h2), .prose :global(:not(h2)) { grid-column: 1; }
    .prose :global(h2 + *) { margin-top: 10px !important; }
  }
</style>
