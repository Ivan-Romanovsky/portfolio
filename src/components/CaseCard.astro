---
interface Props {
  href: string; title: string; summary: string; year: number; kind: string; tone: 'paper' | 'ink' | 'mint';
  cover?: string; focus?: string; soon: string;
}
const { href, title, summary, year, kind, tone, cover, focus = '50% 50%', soon } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<a class="card" href={href} data-cbub>
  <div class:list={['media', tone]}>
    <div class="px" data-parallax>
      {cover
        ? <img src={`${base}${cover.replace(/^\//, '')}`} alt={title} loading="lazy" decoding="async" style={`object-position:${focus}`} />
        : (
          /* until the real cover arrives: a typographic cover, not a fake screenshot */
          <div class="type">
            <span class="big flair">{title}</span>
            <span class="soon">{kind}, {soon}</span>
          </div>
        )}
    </div>
  </div>
  <div class="meta">
    <h3>{title}</h3>
    <span class="yr">{year}</span>
  </div>
  <p class="desc">{summary}</p>
</a>

<style>
  .card { display: grid; gap: 14px; text-decoration: none; color: inherit; }
  @media (hover: hover) and (pointer: fine) { .card { cursor: none; } }
  .media { position: relative; aspect-ratio: 1 / 1.08; overflow: hidden; border-radius: var(--r); background: var(--paper); }
  .media.ink { background: var(--ink); color: var(--bg); }
  .media.mint { background: var(--mint); }
  .px { position: absolute; inset: -6% 0; }
  .media img, .type { width: 100%; height: 100%; object-fit: cover; transition: transform 1.1s var(--ease); }
  .type { display: grid; align-content: space-between; padding: 13% 7%; }
  .big { font-weight: 500; font-size: clamp(40px, 5.4vw, 92px); line-height: 0.92; letter-spacing: -0.06em; overflow-wrap: anywhere; }
  .soon { font-size: 13px; font-weight: 500; opacity: 0.6; }
  @media (hover: hover) { .card:hover .media img, .card:hover .type { transform: scale(1.04); } }
  .meta { display: flex; justify-content: space-between; gap: 12px; align-items: baseline; margin-top: 6px; }
  h3 { margin: 0; font-weight: 500; font-size: clamp(26px, 2.6vw, 38px); line-height: 1.1; letter-spacing: -0.04em; }
  .yr { font: 400 13px/1 var(--f-mono); color: var(--mute); }
  .desc { margin: 0; color: var(--mute); font-size: 15px; max-width: 46ch; font-variation-settings: 'FLAR' 100; }
</style>
