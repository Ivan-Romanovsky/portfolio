---
import Nav from './Nav.astro';
import { t, contacts, type Lang } from '../i18n';
import grid from '../../public/character/grid.json';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t[lang];
const base = import.meta.env.BASE_URL;
const src = `${base}character/`;
const [bx, by, bx1, by1] = grid.box;
// head canvas positioned in % of the frame, so it sits exactly over the base image at any size
const box = {
  left: (bx / grid.w) * 100, top: (by / grid.h) * 100,
  width: ((bx1 - bx) / grid.w) * 100, height: ((by1 - by) / grid.h) * 100,
};
---
<section class="hero" style={`--stage:${grid.bg}`} data-hero>
  <Nav lang={lang} overlay />

  <div class="intro" data-reveal>
    <h1>
      <span class="visually-hidden">{d.name}. </span>
      <span class="line"><span>{d.hero.line1}</span></span>
      <span class="line sub"><span>{d.hero.line2}</span></span>
    </h1>
  </div>

  <a class="talk" href={`https://t.me/${contacts.telegram}`} target="_blank" rel="noopener" data-magnet>
    <span>{d.cta}</span>
  </a>

  <div class="frame" data-character data-src={src}>
    <img class="base" src={`${src}base.webp`} width={grid.w} height={grid.h} alt="" fetchpriority="high" decoding="async" />
    <canvas class="head" width={bx1 - bx} height={by1 - by}
      style={`left:${box.left}%;top:${box.top}%;width:${box.width}%;height:${box.height}%`} aria-hidden="true"></canvas>
  </div>

  <div class="wm" aria-hidden="true" data-wordmark>
    <span class="line"><span>{d.hero.wordmark}<em>.</em></span></span>
  </div>
</section>

<style>
  .hero {
    position: relative; overflow: hidden; isolation: isolate;
    height: max(600px, min(100svh - 24px, 900px));
    margin: 12px var(--gut-r) 0 var(--gut);
    border-radius: var(--r); background: var(--stage);
  }

  .intro { position: absolute; z-index: 2; left: var(--pad); top: 38%; max-width: 22ch; }
  h1 { margin: 0; font-weight: 500; font-size: clamp(18px, 1.5vw, 22px); line-height: 1.3; letter-spacing: -0.02em; }
  .sub { color: var(--ink-2); font-weight: 400; }

  /* round CTA floating in the stage, like Bram's "Koffie?" */
  .talk {
    position: absolute; z-index: 3; right: clamp(24px, 9vw, 160px); top: 30%;
    width: clamp(96px, 8vw, 124px); aspect-ratio: 1; border-radius: 50%;
    display: grid; place-items: center; text-align: center; text-decoration: none;
    background: var(--ink); color: var(--bg); font-size: 15px; font-weight: 500; line-height: 1.15;
    transition: background-color 0.35s var(--ease), color 0.35s var(--ease);
    will-change: transform;
  }
  .talk span { display: block; max-width: 9ch; }
  @media (hover: hover) { .talk:hover { background: var(--mint); color: var(--ink); } }

  /* the generated frame is 16:9; shoulders run off the bottom edge */
  .frame {
    position: absolute; left: 50%; bottom: 0; z-index: 0;
    height: 96%; aspect-ratio: 16 / 9; transform: translateX(-50%);
    -webkit-mask-image: radial-gradient(ellipse 60% 76% at 50% 52%, #000 72%, transparent 100%);
            mask-image: radial-gradient(ellipse 60% 76% at 50% 52%, #000 72%, transparent 100%);
  }
  .base { width: 100%; height: 100%; object-fit: cover; }
  .head { position: absolute; display: block; }

  /* giant name set over the shirt, cut by the bottom edge */
  .wm {
    position: absolute; z-index: 1; left: 0; right: 0; bottom: -0.2em; text-align: center; white-space: nowrap;
    font-weight: 500; font-size: clamp(56px, 15.2vw, 232px); line-height: 1; letter-spacing: -0.065em; color: var(--ink);
  }
  .wm .line { padding-bottom: 0; margin-bottom: 0; }
  .wm em { font-style: normal; color: var(--mint); -webkit-text-stroke: 0.02em var(--ink); }

  @media (max-width: 760px) {
    .hero { height: max(560px, calc(100svh - 24px)); }
    .intro { top: 92px; }
    .talk { top: auto; bottom: 26%; right: 20px; width: 92px; font-size: 14px; }
    .frame { height: 74%; }
  }
</style>

<script>
  import { mountCharacter } from '../scripts/character';
  const el = document.querySelector<HTMLElement>('[data-character]');
  if (el) mountCharacter(el);
</script>
