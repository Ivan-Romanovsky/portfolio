---
import Nav from './Nav.astro';
import { t, contacts, type Lang, url } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t[lang];
const base = import.meta.env.BASE_URL;
const model = url(base, 'character3d/model.glb');
const [l1, l2, l3] = d.hero.lines;
---
<!--
  Bram van Vugt's first-screen layout around a live 3D character: name left and links right in the
  header, three short lines on the left, a round contact button on the right. The background is one
  flat warm colour with a mint disc behind the head, like a studio backdrop with a spotlight.
-->
<section class="hero" data-hero>
  <div class="disc" aria-hidden="true"></div>
  <div class="scene" data-character3d data-model={model}>
    <canvas role="img" aria-label={lang === 'ru' ? 'Мультяшный 3D-Иван следит за курсором' : 'Cartoon 3D Ivan following the cursor'}></canvas>
  </div>

  <Nav lang={lang} overlay />

  <h1 class="intro" data-reveal>
    <span class="visually-hidden">{d.name}. </span>
    <span class="line"><span class="flair">{l1}</span></span>
    <span class="line"><span class="flair">{l2}</span></span>
    <span class="line dim"><span>{l3}</span></span>
  </h1>

  <a class="talk" href={`https://t.me/${contacts.telegram}`} target="_blank" rel="noopener" data-magnet>
    <span>{d.cta}</span>
  </a>

</section>

<style>
  .hero { position: relative; overflow: hidden; isolation: isolate; height: max(620px, 100svh); background: var(--paper); }
  /* spotlight disc behind the head; drifts a little with the cursor (set from the script) */
  .disc {
    position: absolute; z-index: 0; left: 50%; top: 50%; width: min(64vh, 52vw); aspect-ratio: 1; border-radius: 50%;
    background: var(--mint); transform: translate(calc(-50% + var(--dx, 0px)), calc(-58% + var(--dy, 0px)));
    opacity: 0; transition: opacity 1s var(--ease);
  }
  .hero.ready .disc { opacity: 1; }
  .scene { position: absolute; inset: 0; z-index: 1; }
  .scene canvas { display: block; width: 100%; height: 100%; opacity: 0; transform: translateY(24px); transition: opacity 0.9s var(--ease), transform 1.2s var(--ease); }
  .scene canvas.on { opacity: 1; transform: none; }

  .intro { position: absolute; z-index: 2; left: 36px; top: 31%; margin: 0; font-weight: 500; font-size: clamp(18px, 1.45vw, 21px); line-height: 1.24; letter-spacing: -0.02em; }
  .intro .dim { color: var(--ink-2); font-weight: 400; opacity: 0.8; }

  .talk {
    position: absolute; z-index: 3; right: clamp(24px, 13vw, 200px); top: 21%;
    width: clamp(88px, 6.6vw, 104px); aspect-ratio: 1; border-radius: 50%;
    display: grid; place-items: center; text-align: center; text-decoration: none;
    background: var(--ink); color: var(--bg); font-size: 15px; font-weight: 400; line-height: 1.15;
    transition: background-color 0.35s var(--ease), color 0.35s var(--ease);
    will-change: transform;
  }
  .talk span { display: block; max-width: 9ch; }
  @media (hover: hover) { .talk:hover { background: var(--mint); color: var(--ink); } }

  @media (max-width: 760px) {
    .hero { height: max(560px, 88svh); }
    .disc { width: 84vw; top: 52%; }
    .scene { top: 16%; bottom: 12%; }
    .intro { left: 20px; top: 84px; }
    .talk { top: auto; bottom: 3.5vh; right: 18px; width: 84px; font-size: 14px; }
  }
</style>

<script>
  import { mountCharacter3D } from '../scripts/character3d';
  const el = document.querySelector<HTMLElement>('[data-character3d]');
  if (el) mountCharacter3D(el).then(() => el.closest('.hero')?.classList.add('ready')).catch((e) => console.error(e));
</script>
