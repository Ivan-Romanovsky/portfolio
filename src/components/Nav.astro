---
import { t, type Lang, otherLangPath, url } from '../i18n';
interface Props { lang: Lang; overlay?: boolean }
const { lang, overlay = false } = Astro.props;
const d = t[lang];
const base = import.meta.env.BASE_URL;
const home = url(base, lang === 'en' ? 'en/' : '');
---
<!-- Bram-style header: name left, plain links right, no bar or background -->
<nav class:list={['nav', { overlay }]} aria-label={lang === 'ru' ? 'Основное меню' : 'Main'}>
  <a class="name" href={home}>{d.name}<span>.</span></a>
  <ul>
    <li><a href={`${home}#cases`}>{d.nav.cases}</a></li>
    <li><a href={`${home}#about`}>{d.nav.about}</a></li>
    <li><a href={`${home}#services`}>{d.nav.services}</a></li>
    <li><a href={`${home}#contact`}>{d.nav.contact}</a></li>
    <li><a class="lang" href={otherLangPath(Astro.url.pathname, base, lang)} hreflang={lang === 'ru' ? 'en' : 'ru'}>{d.langSwitch}</a></li>
  </ul>
</nav>

<style>
  .nav { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 24px 36px; position: relative; z-index: 3; }
  .nav.overlay { position: absolute; left: 0; right: 0; top: 0; }
  .name { text-decoration: none; font-weight: 500; font-size: 17px; letter-spacing: -0.02em; }
  .name span { color: var(--mint); -webkit-text-stroke: 0.4px var(--ink); }
  ul { display: flex; gap: 6px; list-style: none; margin: 0; padding: 0; font-size: 15px; font-weight: 500; }
  ul a { position: relative; display: block; padding: 8px 12px; text-decoration: none; }
  /* small dot under the hovered link, like Bram's current-page marker */
  ul a::after { content: ''; position: absolute; left: 50%; bottom: -2px; width: 4px; height: 4px; margin-left: -2px; border-radius: 50%; background: currentColor; transform: scale(0); transition: transform 0.35s var(--ease); }
  @media (hover: hover) { ul a:hover::after { transform: scale(1); } }
  .lang { opacity: 0.6; }
  @media (max-width: 760px) {
    .nav { padding: 20px; }
    ul { display: none; }
  }
</style>
