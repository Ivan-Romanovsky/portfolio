---
import { t, type Lang, otherLangPath, url } from '../i18n';
interface Props { lang: Lang; overlay?: boolean }
const { lang, overlay = false } = Astro.props;
const d = t[lang];
const base = import.meta.env.BASE_URL;
const home = url(base, lang === 'en' ? 'en/' : '');
---
<nav class:list={['nav', { overlay }]} aria-label={lang === 'ru' ? 'Основное меню' : 'Main'}>
  <a class="name" href={home}>{d.name}</a>
  <ul>
    <li><a href={`${home}#cases`}>{d.nav.cases}</a></li>
    <li><a href={`${home}#about`}>{d.nav.about}</a></li>
    <li><a href={`${home}#services`}>{d.nav.services}</a></li>
    <li><a href={`${home}#contact`}>{d.nav.contact}</a></li>
  </ul>
  <a class="lang" href={otherLangPath(Astro.url.pathname, base, lang)} hreflang={lang === 'ru' ? 'en' : 'ru'}>{d.langSwitch}</a>
</nav>

<style>
  .nav { display: flex; align-items: center; gap: clamp(16px, 2.6vw, 36px); height: 72px; padding: 0 var(--pad); position: relative; z-index: 3; font-size: 15px; font-weight: 500; }
  .nav.overlay { position: absolute; left: 0; right: 0; top: 0; }
  .name { text-decoration: none; margin-right: auto; letter-spacing: -0.01em; }
  ul { display: flex; gap: clamp(16px, 2.6vw, 36px); list-style: none; margin: 0; padding: 0; }
  ul a { text-decoration: none; position: relative; }
  ul a::after { content: ''; position: absolute; left: 0; right: 0; bottom: -4px; height: 1.5px; background: currentColor; transform: scaleX(0); transform-origin: right; transition: transform 0.45s var(--ease); }
  @media (hover: hover) { ul a:hover::after { transform: scaleX(1); transform-origin: left; } }
  .lang { text-decoration: none; font-size: 13px; padding: 7px 11px; border-radius: 999px; box-shadow: inset 0 0 0 1px currentColor; transition: background-color 0.3s var(--ease); }
  @media (hover: hover) { .lang:hover { background: var(--mint); box-shadow: inset 0 0 0 1px var(--mint); } }
  @media (max-width: 760px) { ul, .lang { display: none; } }
</style>
